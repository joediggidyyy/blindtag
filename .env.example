# BlindTag — Environment Variable Template
#
# Copy this file to .env and populate values as needed.
# .env is gitignored and must NEVER be committed.
#
# BlindTag retained reporting / export gates
# Leave blank unless you are enabling signed operational or elevated forensic exports.

# Operational retained-export shared-key gate (Pass J baseline)
BLINDTAG_EXPORT_SIGNING_KEY=
BLINDTAG_EXPORT_SIGNING_KEY_ID=configured-shared-key
BLINDTAG_EXPORT_ALLOWED_REQUESTERS=

# Elevated provenance / forensic gate (Pass R)
# Use PEM-encoded Ed25519 key material for verifier-friendly high-trust exports.
BLINDTAG_FORENSIC_SIGNING_PRIVATE_KEY=
BLINDTAG_FORENSIC_SIGNING_PUBLIC_KEY=
BLINDTAG_FORENSIC_SIGNING_KEY_ID=configured-ed25519-key
BLINDTAG_FORENSIC_ALLOWED_REQUESTERS=
