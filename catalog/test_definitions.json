    {
      "id": "blindtag-core",
      "title": "BlindTag Core Codec Engine",
      "summary": "Unit tests for the Plane 14 steganographic encode/decode/strip_plane14 engine, validation boundaries, normalization resistance, and adversarial crash immunity.",
      "status": "active",
      "category": "general",
      "selector_policy": "exact-name-only",
      "profiles": ["default", "smoke", "release"],
      "tags": ["api", "smoke"],
      "policy_flags": ["deterministic-output", "local-only"],
      "evidence_requirements": ["stdout_capture", "stderr_capture", "report_json"],
      "default_lanes": ["pytest"],
      "metadata": {
        "module": "blindtag.core",
        "test_file": "tests/test_core.py"
      },
      "lanes": {
        "pytest": [
          {
            "id": "core-pytest",
            "title": "pytest tests/test_core.py",
            "command": ["{python}", "-m", "pytest", "tests/test_core.py", "-v", "--tb=short"],
            "expected_artifacts": ["stdout", "stderr"],
            "evidence_requirements": ["stdout_capture", "stderr_capture"],
            "notes": "Codec round-trip, adversarial, normalization, boundary enforcement."
          }
        ],
        "sandbox_test": [],
        "empirical_test": []
      }
    },
